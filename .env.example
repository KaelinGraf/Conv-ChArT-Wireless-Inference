# Copy to .env (docker compose reads it automatically) and adjust per machine.
# Every value has a default in compose.yaml, so .env is optional.

# Match the container user to your login so bind-mounted files stay yours (id -u / id -g).
# Baked in at build time: when cross-building on another machine, use the Pi user's values.
UID=1000
GID=1000

# ROS 2: the Pi and the laptop running the inference node must agree on both.
# RMW: rmw_cyclonedds_cpp (default, see docker/ros/cyclonedds.xml) or rmw_zenoh_cpp.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Leave WITH_CAMERA at 0: the camera runs on p4p_camera's default v4l2 backend,
# which needs nothing extra in the image. What it does need is on the HOST (see
# docker/README.md): `camera_auto_detect=0` and `dtoverlay=arducam-pivariety` in
# /boot/firmware/config.txt, the CSI pipeline service from host-setup-pi.sh, and
# the camera profile:  docker compose --profile camera up -d pi-camera
# WITH_CAMERA=1 (rebuild after changing) only adds v4l-utils, v4l2_camera and the
# image_transport plugins. Its Arducam libcamera + picamera2 step cannot install
# on this Ubuntu base (Arducam ship Raspberry Pi OS packages only).
WITH_CAMERA=0
# Optional: pin Arducam's picamera2 fork to a ref instead of tracking main.
ARDUCAM_PICAMERA2_REF=main
# Host device node of the Arduino Mega 2560. Docker refuses to start the
# containers while it is missing, so with no Arduino attached use /dev/null.
ARDUINO_PORT=/dev/ttyACM0
