# Copy to .env (docker compose reads it automatically) and adjust per machine.
# Every value has a default in compose.yaml, so .env is optional.

# Match the container user to your login so bind-mounted files stay yours (id -u / id -g).
# Baked in at build time: when cross-building on another machine, use the Pi user's values.
UID=1000
GID=1000

ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

WITH_CAMERA=0
ARDUCAM_PICAMERA2_REF=main
ARDUINO_PORT=/dev/ttyACM0
