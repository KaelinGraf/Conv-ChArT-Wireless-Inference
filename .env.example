# Copy to .env (docker compose reads it automatically) and adjust per machine.
# Every value has a default in compose.yaml, so .env is optional.

# Match the container user to your login so bind-mounted files stay yours (id -u / id -g).
# Baked in at build time: when cross-building on another machine, use the Pi user's values.
UID=1000
GID=1000

# ROS 2: the Pi and the laptop running the inference node must agree on both.
# RMW: rmw_cyclonedds_cpp (default, see docker/ros/cyclonedds.xml) or rmw_zenoh_cpp.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# WITH_CAMERA=1 installs v4l-utils, v4l2_camera / image_transport plugins and
# Arducam's libcamera fork + their picamera2, for the Pivariety OV2311 that
# p4p_camera drives (rebuild after changing). Two things it does NOT do:
#   - the kernel driver and overlay are the HOST's job. /boot/firmware/config.txt
#     needs `camera_auto_detect=0` and `dtoverlay=arducam-pivariety`, then a reboot.
#   - the plain `pi` service passes through no camera devices. Use the camera
#     profile instead:  docker compose --profile camera up -d pi-camera
# Arducam's .debs target Debian bookworm / python 3.11 while this image is Ubuntu
# noble / python 3.12, so the binding may not import. Check it first, inside the
# container:  python3 -c "from picamera2 import Picamera2; print(Picamera2().sensor_modes)"
WITH_CAMERA=0
# Optional: pin Arducam's picamera2 fork to a ref instead of tracking main.
ARDUCAM_PICAMERA2_REF=main
# Host device node of the Arduino Mega 2560.
ARDUINO_PORT=/dev/ttyACM0
